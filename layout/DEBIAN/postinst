#!/bin/sh
#
# Aevon postinst — deliberately boring.
#
# Rules for this script:
#   1. It must never return non-zero (a failed postinst leaves dpkg dirty).
#   2. It must never modify a system file.
#   3. It must never restart SpringBoard. Activation is a separate,
#      human decision — you get a chance to look at the package first.
#
set +e

# roothide 的维护脚本跑在 libvroot 里："/" 是 jbroot，真实根在 /rootfs。
# 两个都试一次；失败也无所谓，插件加载时会自己建目录。
for ROOT in /rootfs/var/mobile /var/mobile; do
    LOG_DIR="$ROOT/Library/Logs/Aevon"
    if mkdir -p "$LOG_DIR" 2>/dev/null; then
        chown -R mobile:mobile "$LOG_DIR" 2>/dev/null
        break
    fi
done

echo ""
echo "  Aevon 0.0.2 installed (roothide / arm64e, zero hooks)."
echo ""
echo "  Everything is operated from the GUI. No terminal needed:"
echo "      Settings > Aevon"
echo ""
echo "  SpringBoard was NOT restarted on purpose. Nothing happens until you"
echo "  reload it once (Settings > Aevon > Reload Desktop, or your jailbreak"
echo "  app's respring button)."
echo ""
echo "  Emergency stop, from the GUI:"
echo "      Settings > Aevon > Emergency stop (G0)  ->  Reload Desktop"
echo ""
exit 0
