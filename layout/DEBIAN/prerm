#!/bin/sh
#
# Aevon prerm — keeps your state so a reinstall does not silently
# re-arm a tweak that had already disabled itself.
#
set +e

echo "[Aevon] removing. State kept at /var/mobile/Library/Logs/Aevon/state.plist"
echo "[Aevon] log kept at /var/mobile/Aevon.log"
echo "[Aevon] a stale SpringBoard copy stays loaded until you reload SpringBoard."

exit 0
