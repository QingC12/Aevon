#!/bin/sh
# aevon-enable — 清掉 panic 标记与自禁用状态，让 Aevon 下次加载时重新开始。
set -u

JB=""
for d in /var/containers/Bundle/Application/.jbroot-*; do
    [ -d "$d" ] && JB="$d" && break
done
if [ -z "$JB" ] && [ -d /var/jb ]; then JB="/var/jb"; fi
[ -n "$JB" ] && PATH="$JB/usr/bin:$PATH"
export PATH

DATA="/var/mobile"
if [ -d /rootfs/var/mobile ]; then DATA="/rootfs/var/mobile"; fi
AEV="$DATA/Library/Logs/Aevon"

rm -f "$AEV/panic" 2>/dev/null
rm -f "$AEV/state.plist" 2>/dev/null
rm -f "$DATA/Library/Preferences/com.aevon.panic" 2>/dev/null       # 旧版本遗留
rm -f "$DATA/Library/Preferences/com.aevon.state.plist" 2>/dev/null

if command -v defaults >/dev/null 2>&1; then
    defaults delete com.aevon.aevon panic 2>/dev/null
    defaults delete com.aevon.aevon disabled 2>/dev/null
fi

echo "[aevon] 已清除 panic 标记与状态文件"
echo "[aevon] 用越狱工具重启一次桌面即可恢复加载"
