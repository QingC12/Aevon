#!/bin/sh
# aevon-status — 一眼看清 Aevon 当前是否在生效、为什么停用。
set -u

JB=""
for d in /var/containers/Bundle/Application/.jbroot-*; do
    [ -d "$d" ] && JB="$d" && break
done
if [ -z "$JB" ] && [ -d /var/jb ]; then JB="/var/jb"; fi
[ -n "$JB" ] && PATH="$JB/usr/bin:$PATH"
export PATH

DATA="/var/mobile"
if [ -d /rootfs/var/mobile ]; then DATA="/rootfs/var/mobile"; fi
AEV="$DATA/Library/Logs/Aevon"
P="$AEV/panic"
S="$AEV/state.plist"
L="$AEV/aevon.log"

echo "===== Aevon status ====="
echo "jbroot     : ${JB:-未检测到}"
echo "data root  : $DATA"

if [ -f "$P" ] || [ -f "$DATA/Library/Preferences/com.aevon.panic" ]; then
    echo "panic flag : PRESENT  -> 完全停用"
else
    echo "panic flag : absent"
fi

if [ -f "$S" ]; then
    echo "state file : $S"
    cat "$S"
else
    echo "state file : none (从未加载，或已清除)"
fi

echo ""
echo "loaded dylibs:"
ls -l "$JB/Library/MobileSubstrate/DynamicLibraries/" 2>/dev/null | grep -i aevon

echo ""
echo "prefs:"
if command -v defaults >/dev/null 2>&1; then
    defaults read com.aevon.aevon 2>/dev/null | head -12 || echo "(空)"
fi

echo ""
echo "last log lines:"
tail -n 20 "$L" 2>/dev/null || echo "(no log)"
echo "========================"
